# ============================================================
# ikuuu 自动登录配置模板
# 用法：复制为 .env 后填写真实值。.env 已被 .gitignore 排除，绝不会入库。
#       CI 环境下无需此文件——用 GitHub Secrets 注入同名变量即可（优先级更高）。
# 命名约定：全部 IKUUU_ 前缀，与项目里 W42_* / SMAI_* 保持一致。
# ============================================================

# ---------- 凭据（敏感）----------
# 登录邮箱 / 账号
IKUUU_EMAIL=
# 登录密码
IKUUU_PASSWORD=
# 二次验证 TOTP 密钥（账号开了 2FA 才需要；填的是密钥不是验证码，可离线算码）
IKUUU_TOTP_SECRET=

# ---------- 站点与网络 ----------
# 站点地址（.fyi 为备用域名）
IKUUU_BASE_URL=https://ikuuu.win
# 代理，例如 http://127.0.0.1:7897；留空则直连
IKUUU_PROXY=

# ---------- 登录行为 ----------
# 是否无头：本地首次运行建议 0（有界面，Geetest 卡住时可人工点一下）；CI 用 1
IKUUU_HEADLESS=0
# 等待人工/自动完成验证的最长时间（秒）
IKUUU_LOGIN_TIMEOUT=180
# 是否勾选“记住我”——务必为 1，否则只能拿到会话级 PHPSESSID，关掉浏览器即失效
IKUUU_REMEMBER=1
# 浏览器 UA（一般保持默认即可）
IKUUU_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# ---------- 产物与告警 ----------
# Cookie JSON 存放位置
IKUUU_COOKIE_FILE=ikuuu_cookie.json
# 无过期时间戳时，Cookie 使用超过多少天后强制刷新（默认 25 天）
IKUUU_WARN_AFTER_DAYS=25
# 有 expire_in 时，距过期不足多少天就提前刷新（默认 1.5 天）
# ikuuu 的 Cookie 固定 7 天且【不滑动续期】，这个值决定了 refresh 何时弹浏览器
IKUUU_REFRESH_BEFORE_DAYS=1.5

# ---------- 回写 GitHub Secret（零成本闭环的关键）----------
# 登录/刷新成功后，用 gh CLI 把 Cookie 写回仓库 Secret，
# 这样 GitHub Actions 只管签到、永远不用登录（Geetest 在 runner 上过不了）。
# 需先给 PAT 开 Secrets 读写权限，见 IKUUU_LOGIN.md。
IKUUU_PUSH_SECRET=0
# 目标仓库，格式 owner/repo；留空则写入当前 git 仓库
IKUUU_REPO=1013608955/2026-glados-checkin
# 写入哪个 Secret 名（需与 checkin.yml 里引用的名字一致）
IKUUU_SECRET_NAME=IKUUU_COOKIE
